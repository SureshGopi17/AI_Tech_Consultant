# =====================================================================
# Intelligent Email Agent - Environment Configuration (.env.example)
# =====================================================================

# Server Port
PORT_TASK2=8002

# ---------------------------------------------------------------------
# Google Cloud Platform (GCP) OAuth 2.0 Credentials
# Required for Official Sign in with Google and Live Gmail Integration
# Follow instructions in GOOGLE_CLOUD_SETUP.md to generate these credentials
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8002/api/v1/auth/google/callback

# ---------------------------------------------------------------------
# AI Email Assistant Configuration (Optional)
# If not provided, a deterministic zero-failure local LLM synthesis engine
# is automatically used to guarantee 100% test reliability and offline uptime.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------
# Gmail Connection Mode
# 'demo' = Sandbox mode with pre-seeded demo accounts (no external API calls needed)
# 'live' = Full production Gmail API OAuth 2.0 integration
# ---------------------------------------------------------------------
GMAIL_MODE=demo
GMAIL_ADDRESS=consultant.demo@gmail.com
